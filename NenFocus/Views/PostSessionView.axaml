<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NenFocus.ViewModels.Pages"
             xmlns:conv="using:NenFocus.Converters"
             x:DataType="vm:PostSessionViewModel"
             x:Class="NenFocus.Views.PostSessionView"
             Background="#F5F5F7">

	<UserControl.Resources>
		<conv:DurationToStringConverter x:Key="DurationConverter"/>
		<conv:DateTimeToStringConverter x:Key="DateTimeConverter"/>
	</UserControl.Resources>

	<UserControl.Styles>

		<!-- Done button -->
		<Style Selector="Button.done-btn">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#B8922A"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Height" Value="48"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.done-btn /template/ ContentPresenter">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.done-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#FDF6E8"/>
		</Style>

		<!-- Reflection TextBox -->
		<Style Selector="TextBox.reflection">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#E0E0EE"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="14,12"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="#333344"/>
			<Setter Property="MinHeight" Value="80"/>
		</Style>

		<!-- Scrollbar hidden -->
		<Style Selector="ScrollViewer">
			<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
		</Style>

	</UserControl.Styles>

	<ScrollViewer>
		<StackPanel Margin="52,44,52,44" MaxWidth="600" Spacing="32">

			<!-- ── Header ─────────────────────────────────────── -->
			<StackPanel Spacing="8" HorizontalAlignment="Center">
				<TextBlock Text="✦"
                           FontSize="24"
                           Foreground="#B8922A"
                           HorizontalAlignment="Center"/>
				<TextBlock Text="{Binding HeaderLabel}"
                           FontSize="10"
                           FontWeight="Medium"
                           Foreground="#B8922A"
                           LetterSpacing="4"
                           HorizontalAlignment="Center"/>
			</StackPanel>

			<!-- ── Summary card ───────────────────────────────── -->
			<Border Background="#FFFFFF"
                    CornerRadius="14"
                    BorderBrush="#E8E8F0"
                    BorderThickness="1"
                    Padding="32,28">
				<StackPanel Spacing="20">

					<!-- Goal -->
					<TextBlock Text="{Binding Goal}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1A1A2E"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

					<!-- Divider -->
					<Border Height="1" Background="#EEEEF5"/>

					<!-- Stats grid (RowSpacing removed, margins added to row 0 and 1) -->
					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">

						<!-- Duration -->
						<StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,0,14">
							<TextBlock Text="DURATION"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       Foreground="#AAAABC"
                                       LetterSpacing="2"/>
							<TextBlock Text="{Binding Duration, Converter={StaticResource DurationConverter}}"
                                       FontSize="20"
                                       FontWeight="Light"
                                       Foreground="#1A1A2E"/>
						</StackPanel>

						<!-- Planned -->
						<StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,14">
							<TextBlock Text="PLANNED"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       Foreground="#AAAABC"
                                       LetterSpacing="2"/>
							<TextBlock Text="{Binding PlannedDuration, Converter={StaticResource DurationConverter}}"
                                       FontSize="20"
                                       FontWeight="Light"
                                       Foreground="#1A1A2E"/>
						</StackPanel>

						<!-- Time range -->
						<StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,0,0,14">
							<TextBlock Text="TIME"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       Foreground="#AAAABC"
                                       LetterSpacing="2"/>
							<StackPanel Orientation="Horizontal" Spacing="4">
								<TextBlock Text="{Binding StartedAt, Converter={StaticResource DateTimeConverter}}"
                                           FontSize="14"
                                           Foreground="#555566"/>
								<TextBlock Text="→"
                                           FontSize="14"
                                           Foreground="#BBBBCC"/>
								<TextBlock Text="{Binding EndedAt, Converter={StaticResource DateTimeConverter}}"
                                           FontSize="14"
                                           Foreground="#555566"/>
							</StackPanel>
						</StackPanel>

						<!-- Breaks -->
						<StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,0,0,14">
							<TextBlock Text="BREAKS"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       Foreground="#AAAABC"
                                       LetterSpacing="2"/>
							<TextBlock Text="{Binding BreaksTaken}"
                                       FontSize="20"
                                       FontWeight="Light"
                                       Foreground="#1A1A2E"/>
						</StackPanel>

						<!-- Profile -->
						<StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
							<TextBlock Text="PROFILE"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       Foreground="#AAAABC"
                                       LetterSpacing="2"/>
							<TextBlock Text="{Binding ProfileName}"
                                       FontSize="14"
                                       Foreground="#555566"/>
						</StackPanel>

					</Grid>

				</StackPanel>
			</Border>

			<!-- ── Blocked attempts ───────────────────────────── -->
			<Border Background="#FFFFFF"
					CornerRadius="14"
					BorderBrush="#E8E8F0"
					BorderThickness="1"
					Padding="32,24"
					IsVisible="{Binding HasBlockedAttempts}">
				<StackPanel Spacing="14">

					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Text="BLOCKED ATTEMPTS"
								   FontSize="9"
								   FontWeight="Medium"
								   Foreground="#AAAABC"
								   LetterSpacing="2"
								   VerticalAlignment="Center"/>
						<Border Background="#FDF6E8"
								CornerRadius="10"
								Padding="8,3">
							<!-- FIXED: Only one child (TextBlock) allowed here -->
							<TextBlock Text="{Binding TotalBlockedAttempts}"
									   FontSize="11"
									   FontWeight="SemiBold"
									   Foreground="#B8922A"/>
						</Border>
					</StackPanel>

					<ItemsControl ItemsSource="{Binding BlockedAttemptItems}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="vm:BlockedAttemptItemViewModel">
								<Border Padding="0,5">
									<Grid ColumnDefinitions="*,Auto">
										<!-- FIXED: Wrapped the name and label in a StackPanel -->
										<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
											<TextBlock Text="{Binding ProcessName}"
													   FontSize="13"
													   Foreground="#555566"/>
											<TextBlock Text="{Binding TypeLabel}"
													   FontSize="10"
													   Foreground="#AAAABC"
													   VerticalAlignment="Center"
													   Opacity="0.7"/>
										</StackPanel>

										<Border Grid.Column="1"
												Background="#F5F5FA"
												CornerRadius="6"
												Padding="8,2">
											<TextBlock Text="{Binding AttemptCount, StringFormat='{}{0}×'}"
													   FontSize="12"
													   FontWeight="Medium"
													   Foreground="#888899"/>
										</Border>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

				</StackPanel>
			</Border>

			<!-- ── Reflection ─────────────────────────────────── -->
			<Border Background="#FFFFFF"
                    CornerRadius="14"
                    BorderBrush="#E8E8F0"
                    BorderThickness="1"
                    Padding="32,24">
				<StackPanel Spacing="12">

					<TextBlock Text="REFLECTION"
                               FontSize="9"
                               FontWeight="Medium"
                               Foreground="#AAAABC"
                               LetterSpacing="2"/>

					<TextBlock Text="{Binding ReflectionPrompt}"
                               FontSize="13"
                               Foreground="#BBBBCC"
                               FontStyle="Italic"/>

					<TextBox Classes="reflection"
                             Text="{Binding ReflectionText}"
                             Watermark="Write a quick note..."
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>

				</StackPanel>
			</Border>

			<!-- ── Done button ────────────────────────────────── -->
			<Button Classes="done-btn"
                    Command="{Binding DoneCommand}">
				<TextBlock Text="DONE"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#B8922A"
                           LetterSpacing="3"/>
			</Button>

			<!-- Bottom spacing -->
			<Border Height="20"/>

		</StackPanel>
	</ScrollViewer>

</UserControl>
