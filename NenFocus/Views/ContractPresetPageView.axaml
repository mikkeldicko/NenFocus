<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NenFocus.ViewModels.Pages"
             xmlns:conv="using:NenFocus.Converters"
             x:DataType="vm:ContractPresetPageViewModel"
             x:Class="NenFocus.Views.ContractPresetPageView"
             Background="#F5F5F7">

	<UserControl.Styles>
		<Style Selector="Border.preset-card">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.preset-card:pointerover">
			<Setter Property="Background" Value="#FAFAFA"/>
		</Style>
		<Style Selector="Border.preset-card StackPanel.card-actions">
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.preset-card:pointerover StackPanel.card-actions">
			<Setter Property="Opacity" Value="1"/>
		</Style>
		<Style Selector="Button.icon-btn">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="8,5"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.icon-btn /template/ ContentPresenter">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.1"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#F0F0F8"/>
		</Style>
		<Style Selector="Button.icon-btn.danger:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#FFF0F0"/>
		</Style>
		<Style Selector="Button.primary">
			<Setter Property="Background" Value="#1A1A2E"/>
			<Setter Property="Foreground" Value="#FFFFFF"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="20,10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="Medium"/>
		</Style>
		<Style Selector="Button.primary:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#2A2A4E"/>
		</Style>
		<Style Selector="Button.secondary">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#888899"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#E0E0EE"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="20,10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
		<Style Selector="Button.danger-btn">
			<Setter Property="Background" Value="#C0392B"/>
			<Setter Property="Foreground" Value="#FFFFFF"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="20,10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="Medium"/>
		</Style>
		<Style Selector="Button.danger-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#A93226"/>
		</Style>
		<Style Selector="TextBox.form-field">
			<Setter Property="Background" Value="#F8F8FC"/>
			<Setter Property="BorderBrush" Value="#E0E0EE"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="12,10"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>
		<Style Selector="TextBox.form-field:focus /template/ Border#PART_BorderElement">
			<Setter Property="BorderBrush" Value="#B8922A"/>
		</Style>
	</UserControl.Styles>

	<Panel>

		<!-- MAIN CONTENT -->
		<ScrollViewer>
			<StackPanel Margin="52,44,52,44" MaxWidth="760" Spacing="32">

				<Grid ColumnDefinitions="*,Auto">
					<StackPanel Grid.Column="0" Spacing="4">
						<TextBlock Text="CONTRACT PRESETS" FontSize="9" FontWeight="Medium"
                                   Foreground="#AAAABC" LetterSpacing="4"/>
						<TextBlock Text="Reusable rule sets for Nen Contracts" FontSize="24"
                                   FontWeight="SemiBold" Foreground="#1A1A2E"/>
					</StackPanel>
					<Button Grid.Column="1" Classes="primary" VerticalAlignment="Center"
                            Command="{Binding NewPresetCommand}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Text="+" FontSize="16" VerticalAlignment="Center"/>
							<TextBlock Text="New Preset" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</Grid>

				<TextBlock IsVisible="{Binding IsLoading}" Text="Loading…"
                           FontSize="14" Foreground="#AAAABC" HorizontalAlignment="Center"/>

				<Border IsVisible="{Binding HasNoPresets}"
                        Background="#FFFFFF" CornerRadius="14"
                        BorderBrush="#E8E8F0" BorderThickness="1" Padding="52,48">
					<StackPanel Spacing="12" HorizontalAlignment="Center">
						<TextBlock Text="◫" FontSize="36" Foreground="#DDDDEE"
                                   HorizontalAlignment="Center"/>
						<TextBlock Text="No contract presets yet"
                                   FontSize="16" FontWeight="Medium" Foreground="#888899"
                                   HorizontalAlignment="Center"/>
						<TextBlock Text="Create a preset with the strictness, daily floor, and work hours you reuse most, then pick it when starting a new Nen Contract."
                                   FontSize="13" Foreground="#BBBBCC"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
					</StackPanel>
				</Border>

				<ItemsControl ItemsSource="{Binding Presets}"
                              IsVisible="{Binding !HasNoPresets}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="12"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="vm:ContractPresetCardViewModel">
							<Border Classes="preset-card" CornerRadius="14"
                                    BorderBrush="#E8E8F0" BorderThickness="1" Padding="24,20">

								<Grid ColumnDefinitions="*,Auto">
									<StackPanel Grid.Column="0" Spacing="6">
										<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
											<TextBlock Text="{Binding Name}"
                                                       FontSize="16" FontWeight="SemiBold" Foreground="#1A1A2E"
                                                       VerticalAlignment="Center"/>
											<Border CornerRadius="10" Padding="8,3" Background="#F0F0F8">
												<TextBlock Text="{Binding StrictnessRule, Converter={x:Static conv:StrictnessRuleToLabelConverter.Instance}}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#1A1A2E"/>
											</Border>
										</StackPanel>
										<TextBlock Text="{Binding FloorLabel}" FontSize="12" Foreground="#AAAABC"/>
										<TextBlock Text="{Binding WorkHoursLabel}" FontSize="12" Foreground="#AAAABC"/>
										<TextBlock Text="{Binding CancellationLabel}" FontSize="12" Foreground="#AAAABC"/>
										<TextBlock Text="{Binding RedemptionPlacementLabel}" FontSize="12" Foreground="#AAAABC"/>
										<TextBlock Text="{Binding BreakBlockingLabel}" FontSize="12" Foreground="#AAAABC"/>
									</StackPanel>
									<StackPanel Grid.Column="1" Classes="card-actions"
                                                Orientation="Horizontal" Spacing="2"
                                                VerticalAlignment="Center">
										<Button Classes="icon-btn" ToolTip.Tip="Edit"
                                                Command="{Binding $parent[UserControl].((vm:ContractPresetPageViewModel)DataContext).EditPresetCommand}"
                                                CommandParameter="{Binding}">
											<TextBlock Text="✎" FontSize="14" Foreground="#888899"/>
										</Button>
										<Button Classes="icon-btn danger" ToolTip.Tip="Delete"
                                                Command="{Binding $parent[UserControl].((vm:ContractPresetPageViewModel)DataContext).RequestDeletePresetCommand}"
                                                CommandParameter="{Binding}">
											<TextBlock Text="✕" FontSize="14" Foreground="#C0392B"/>
										</Button>
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

			</StackPanel>
		</ScrollViewer>

		<!-- CREATE / EDIT MODAL -->
		<Border IsVisible="{Binding IsFormVisible}" Background="#88000000">
			<Border Background="#FFFFFF" CornerRadius="16"
                    Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 48 0 #44000000">
				<StackPanel>

					<!-- Header -->
					<Grid ColumnDefinitions="*,Auto" Margin="32,28,32,0">
						<TextBlock Grid.Column="0" Text="{Binding FormTitle}"
                                   FontSize="20" FontWeight="SemiBold" Foreground="#1A1A2E"
                                   VerticalAlignment="Center"/>
						<Button Grid.Column="1" Classes="icon-btn"
                                Command="{Binding CloseFormCommand}">
							<TextBlock Text="✕" FontSize="14" Foreground="#888899"/>
						</Button>
					</Grid>

					<Border Height="1" Background="#F0F0F8" Margin="0,16,0,0"/>

					<StackPanel Margin="32,20,32,0" Spacing="16">

						<StackPanel Spacing="8">
							<TextBlock Text="NAME" FontSize="9" FontWeight="Medium"
                                       Foreground="#AAAABC" LetterSpacing="4"/>
							<TextBox Classes="form-field" Text="{Binding FormName}"
                                     Watermark="e.g. Deep Work Lockdown, Weekend Study…"/>
						</StackPanel>

						<StackPanel Spacing="8">
							<TextBlock Text="STRICTNESS" FontSize="9" FontWeight="Medium"
                                       Foreground="#AAAABC" LetterSpacing="4"/>
							<ComboBox ItemsSource="{Binding StrictnessOptions}"
                                      SelectedItem="{Binding FormStrictnessRule}"
                                      HorizontalAlignment="Stretch">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Converter={x:Static conv:StrictnessRuleToLabelConverter.Instance}}"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</StackPanel>

						<CheckBox Content="Allow cancellation" IsChecked="{Binding AllowCancellation}"/>

						<CheckBox Content="Keep blocking during breaks" IsChecked="{Binding KeepBlockingDuringBreaks}"
						          ToolTip.Tip="Sessions under this contract keep their sites and apps blocked through their breaks."/>

						<StackPanel Spacing="6">
							<CheckBox Content="Enforce a fixed daily floor" IsChecked="{Binding IsDailyFloorEnabled}"/>
							<StackPanel Spacing="4" IsVisible="{Binding IsDailyFloorEnabled}">
								<TextBlock Text="Daily floor (whole hours)" FontSize="12" Foreground="#7A7A8C"/>
								<TextBox Classes="form-field" Text="{Binding DailyFloorHoursText}" Watermark="e.g. 3"/>
							</StackPanel>
						</StackPanel>

						<StackPanel Spacing="8">
							<TextBlock Text="REDEMPTION PLACEMENT" FontSize="9" FontWeight="Medium"
                                       Foreground="#AAAABC" LetterSpacing="4"/>
							<ComboBox ItemsSource="{Binding RedemptionPlacementOptions}"
                                      SelectedItem="{Binding FormRedemptionPlacementPolicy}"
                                      HorizontalAlignment="Stretch">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Converter={x:Static conv:RedemptionPlacementPolicyToLabelConverter.Instance}}"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<TextBlock Text="Which days a redemption block may be placed on to cover a missed or incomplete block."
                                       FontSize="12" Foreground="#AAAABC" TextWrapping="Wrap"/>
						</StackPanel>

						<StackPanel Spacing="6">
							<CheckBox Content="Enforce work hours" IsChecked="{Binding IsWorkHoursEnabled}"/>
							<Grid ColumnDefinitions="*,12,*" IsVisible="{Binding IsWorkHoursEnabled}">
								<StackPanel Grid.Column="0" Spacing="4">
									<TextBlock Text="Start" FontSize="12" Foreground="#7A7A8C"/>
									<AutoCompleteBox ItemsSource="{Binding TimeOptions}" Text="{Binding WorkHoursStartText, Mode=TwoWay}" FilterMode="Contains" Watermark="HH:mm"/>
								</StackPanel>
								<StackPanel Grid.Column="2" Spacing="4">
									<TextBlock Text="End" FontSize="12" Foreground="#7A7A8C"/>
									<AutoCompleteBox ItemsSource="{Binding TimeOptions}" Text="{Binding WorkHoursEndText, Mode=TwoWay}" FilterMode="Contains" Watermark="HH:mm"/>
								</StackPanel>
							</Grid>
						</StackPanel>

					</StackPanel>

					<!-- Error -->
					<Border IsVisible="{Binding FormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="#FFF5F5" CornerRadius="8" Padding="14,10"
                            Margin="32,16,32,0">
						<TextBlock Text="{Binding FormError}" FontSize="13"
                                   Foreground="#C0392B" TextWrapping="Wrap"/>
					</Border>

					<!-- Footer -->
					<Border Height="1" Background="#F0F0F8" Margin="0,20,0,0"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="12" Margin="32,16,32,24">
						<Button Classes="secondary" Command="{Binding CloseFormCommand}">Cancel</Button>
						<Button Classes="primary" Command="{Binding SaveCommand}"
                                Content="{Binding SaveButtonLabel}"/>
					</StackPanel>

				</StackPanel>
			</Border>
		</Border>

		<!-- DELETE CONFIRM -->
		<Border IsVisible="{Binding IsConfirmDeleteVisible}" Background="#88000000">
			<Border Background="#FFFFFF" CornerRadius="14" Width="400" Padding="32,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 48 0 #44000000">
				<StackPanel Spacing="20">
					<TextBlock Text="Delete Contract Preset" FontSize="18" FontWeight="SemiBold" Foreground="#1A1A2E"/>
					<TextBlock Text="{Binding ConfirmDeleteMessage}" FontSize="14" Foreground="#888899" TextWrapping="Wrap"/>
					<TextBlock Text="{Binding ConfirmDeleteError}"
                               IsVisible="{Binding ConfirmDeleteError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12" Foreground="#C03A2B" TextWrapping="Wrap"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
						<Button Classes="secondary" Content="Cancel" Command="{Binding CancelDeleteCommand}"/>
						<Button Classes="danger-btn" Content="Delete" Command="{Binding ConfirmDeleteCommand}"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>

	</Panel>
</UserControl>
