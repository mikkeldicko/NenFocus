<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NenFocus.ViewModels"
        x:DataType="vm:ShellViewModel"
        x:Class="NenFocus.Views.MainWindow"
        Title="NenFocus"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="580"
        Background="#F5F5F7">

	<Window.Styles>
		<Style Selector="Button.nav-item">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="14,11"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.nav-item /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.12"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#EAEAF0"/>
		</Style>
		<Style Selector="Button.nav-item.active /template/ ContentPresenter">
			<Setter Property="Background" Value="#E4E4EE"/>
		</Style>
		<Style Selector="Button.nav-item TextBlock.nav-icon">
			<Setter Property="Foreground" Value="#AAAABC"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Width" Value="20"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.nav-item.active TextBlock.nav-icon">
			<Setter Property="Foreground" Value="#B8922A"/>
		</Style>
		<Style Selector="Button.nav-item:pointerover TextBlock.nav-icon">
			<Setter Property="Foreground" Value="#888899"/>
		</Style>
		<Style Selector="Button.nav-item TextBlock.nav-label">
			<Setter Property="Foreground" Value="#888899"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.nav-item.active TextBlock.nav-label">
			<Setter Property="Foreground" Value="#B8922A"/>
		</Style>
		<Style Selector="Button.nav-item:pointerover TextBlock.nav-label">
			<Setter Property="Foreground" Value="#555566"/>
		</Style>
	</Window.Styles>

	<Grid>

		<!-- Normal shell (sidebar + content) -->
		<Grid ColumnDefinitions="210,*"
              IsVisible="{Binding !IsRitualActive}">

			<Border Grid.Column="0"
                    Background="#EDEDF2"
                    BorderBrush="#DDDDE8"
                    BorderThickness="0,0,1,0"
                    IsVisible="{Binding !IsPostSessionActive}">
				<DockPanel LastChildFill="False">
					<StackPanel DockPanel.Dock="Top" Margin="22,32,22,48">
						<TextBlock Text="NEN" FontSize="22" FontWeight="Black"
                                   Foreground="#B8922A" LetterSpacing="10"/>
						<TextBlock Text="FOCUS" FontSize="8" FontWeight="Light"
                                   Foreground="#AAAABC" LetterSpacing="6"
                                   Margin="2,6,0,0"/>
					</StackPanel>
					<TextBlock DockPanel.Dock="Top"
                               Text="NAVIGATE" FontSize="8" FontWeight="Medium"
                               Foreground="#AAAABC" LetterSpacing="4"
                               Margin="22,0,0,8"/>
					<ItemsControl DockPanel.Dock="Top"
                                  ItemsSource="{Binding NavItems}"
                                  Margin="10,0,10,0">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="vm:NavItemViewModel">
								<Button Classes="nav-item"
                                        Classes.active="{Binding IsSelected}"
                                        Command="{Binding SelectCommand}">
									<StackPanel Orientation="Horizontal" Spacing="12">
										<TextBlock Classes="nav-icon" Text="{Binding Icon}"/>
										<TextBlock Classes="nav-label" Text="{Binding Label}"/>
									</StackPanel>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</DockPanel>
			</Border>

			<!-- Normal page content (hidden during post-session) -->
			<TransitioningContentControl Grid.Column="1"
                                         Content="{Binding CurrentPage}"
                                         PageTransition="{x:Null}"
                                         IsVisible="{Binding !IsPostSessionActive}"/>

			<!-- Post-session overlay (takes full width when active) -->
			<ContentControl Grid.Column="0" Grid.ColumnSpan="2"
                            Content="{Binding PostSessionViewModel}"
                            IsVisible="{Binding IsPostSessionActive}"/>
		</Grid>

		<!-- Ritual full-screen overlay -->
		<ContentControl Content="{Binding RitualViewModel}"
                        IsVisible="{Binding IsRitualActive}"/>

		<!-- Missed-sessions triage full-screen overlay -->
		<ContentControl Content="{Binding TriageViewModel}"
                        IsVisible="{Binding IsTriageActive}"/>

	</Grid>
</Window>
