<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NenFocus.ViewModels.Ritual"
             x:DataType="vm:ZetsuPageViewModel"
             x:Class="NenFocus.Views.ZetsuPageView"
             Background="Transparent">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
        <StackPanel Spacing="0" HorizontalAlignment="Stretch">

            <!-- Kanji -->
            <TextBlock Text="èˆŒ"
                       FontSize="72"
                       FontWeight="Thin"
                       Foreground="#DDDDE8"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28"/>

            <!-- Step name -->
            <TextBlock Text="Zetsu"
                       FontSize="32"
                       FontWeight="Light"
                       Foreground="#1A1A2E"
                       HorizontalAlignment="Center"
                       LetterSpacing="6"/>

            <!-- Subtitle -->
            <TextBlock Text="Put it into words."
                       FontSize="13"
                       FontStyle="Italic"
                       Foreground="#AAAABC"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,48"/>

            <!-- Goal input -->
            <TextBox Text="{Binding Goal}"
                     Watermark="What is your goal for this session?"
                     AcceptsReturn="False"
                     FontSize="15"
                     Padding="0,10,0,10"
                     Background="Transparent"
                     BorderBrush="#DDDDE8"
                     BorderThickness="0,0,0,1"
                     CornerRadius="0"
                     Foreground="#1A1A2E"
                     CaretBrush="#B8922A"
                     Margin="0,0,0,48"/>

            <!-- Continue -->
            <Button HorizontalAlignment="Center"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding CanContinue}"
                    Background="Transparent"
                    BorderBrush="#B8922A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="40,12"
                    Cursor="Hand">
                <TextBlock Text="Continue"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="#B8922A"
                           LetterSpacing="2"/>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>

