<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NenFocus.ViewModels.DevTools"
             x:DataType="vm:DebugClockViewModel"
             x:Class="NenFocus.Views.DebugClockView"
             HorizontalAlignment="Right"
             VerticalAlignment="Top">

    <Border Background="#1A1A2EEE"
            BorderBrush="#B8922A"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Margin="16"
            Width="240">
        <StackPanel Spacing="10">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="DEBUG CLOCK"
                           FontSize="10" FontWeight="Bold"
                           Foreground="#B8922A" LetterSpacing="2"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="✕"
                        Command="{Binding ToggleVisibleCommand}"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#AAAABC" Padding="4" Cursor="Hand"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding CurrentEffectiveTime, StringFormat='{}{0:MMM d, HH:mm:ss}'}"
                           Foreground="White" FontSize="13" FontWeight="Medium"/>
                <Border IsVisible="{Binding IsOverridden}"
                        Background="#B8922A" CornerRadius="4" Padding="5,1">
                    <TextBlock Text="OVERRIDDEN" FontSize="8" FontWeight="Bold" Foreground="#1A1A2E"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <DatePicker SelectedDate="{Binding SelectedDate}" Width="120"/>
                <TimePicker SelectedTime="{Binding SelectedTime}" Width="98"/>
            </StackPanel>

            <Button Content="Set time"
                    Command="{Binding SetTimeCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#B8922A" Foreground="#1A1A2E" FontWeight="Medium"
                    CornerRadius="6" Cursor="Hand"/>

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Button Content="+1h" Command="{Binding AdvanceOneHourCommand}"
                        Background="#2A2A44" Foreground="White" CornerRadius="6" Cursor="Hand"/>
                <Button Content="+6h" Command="{Binding AdvanceSixHoursCommand}"
                        Background="#2A2A44" Foreground="White" CornerRadius="6" Cursor="Hand"/>
                <Button Content="+1d" Command="{Binding AdvanceOneDayCommand}"
                        Background="#2A2A44" Foreground="White" CornerRadius="6" Cursor="Hand"/>
            </StackPanel>

            <Button Content="Reset to real time"
                    Command="{Binding ResetCommand}"
                    IsVisible="{Binding IsOverridden}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="Transparent" BorderBrush="#AAAABC" BorderThickness="1"
                    Foreground="#AAAABC" CornerRadius="6" Cursor="Hand"/>

        </StackPanel>
    </Border>
</UserControl>
