<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NenFocus.ViewModels.Pages"
             x:DataType="vm:PresetsPageViewModel"
             x:Class="NenFocus.Views.PresetsPageView"
             Background="#F5F5F7">

	<UserControl.Styles>
		<Style Selector="Button.page-tab-btn">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#888899"/>
			<Setter Property="BorderThickness" Value="0,0,0,2"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="0"/>
			<Setter Property="Padding" Value="4,10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Medium"/>
		</Style>
		<Style Selector="Button.page-tab-btn.active">
			<Setter Property="Foreground" Value="#1A1A2E"/>
			<Setter Property="BorderBrush" Value="#1A1A2E"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">
		<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20" Margin="52,20,52,0">
			<Button Classes="page-tab-btn" Classes.active="{Binding IsBlockPresetsTabActive}"
                    Content="Block Presets" Command="{Binding ShowBlockPresetsTabCommand}"/>
			<Button Classes="page-tab-btn" Classes.active="{Binding IsContractPresetsTabActive}"
                    Content="Contract Presets" Command="{Binding ShowContractPresetsTabCommand}"/>
		</StackPanel>

		<ContentControl Grid.Row="1" Content="{Binding ActivePage}"/>
	</Grid>
</UserControl>
