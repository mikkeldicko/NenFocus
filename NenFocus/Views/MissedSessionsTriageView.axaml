<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NenFocus.ViewModels"
             x:DataType="vm:MissedSessionsTriageViewModel"
             x:Class="NenFocus.Views.MissedSessionsTriageView"
             Background="#F5F5F7">

	<UserControl.Styles>

		<Style Selector="Button.primary">
			<Setter Property="Background" Value="#1A1A2E"/>
			<Setter Property="Foreground" Value="#FFFFFF"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="20,12"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.primary:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#2A2A4E"/>
		</Style>
		<Style Selector="Button.secondary">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#888899"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#E0E0EE"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="20,12"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#F5F5FA"/>
		</Style>

	</UserControl.Styles>

	<Border Background="#88000000">
		<Border Background="#FFFFFF"
                CornerRadius="16"
                Width="420"
                Padding="36,32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 12 48 0 #44000000">
			<StackPanel Spacing="20" HorizontalAlignment="Center">

				<TextBlock Text="✦"
                           FontSize="24"
                           Foreground="#B8922A"
                           HorizontalAlignment="Center"/>

				<StackPanel Spacing="6" HorizontalAlignment="Center">
					<TextBlock Text="SESSIONS MISSED"
                               FontSize="10"
                               FontWeight="Medium"
                               Foreground="#B8922A"
                               LetterSpacing="4"
                               HorizontalAlignment="Center"/>
					<TextBlock Text="{Binding Count, StringFormat='You missed {0} sessions'}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1A1A2E"
                               HorizontalAlignment="Center"/>
				</StackPanel>

				<TextBlock Text="You can review each one and add a reflection, or skip them all and move on."
                           FontSize="13"
                           Foreground="#888899"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="320"/>

				<StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
					<Button Classes="secondary" Content="Skip All" Command="{Binding SkipAllCommand}"/>
					<Button Classes="primary" Content="Review Each" Command="{Binding ReviewEachCommand}"/>
				</StackPanel>

			</StackPanel>
		</Border>
	</Border>

</UserControl>
