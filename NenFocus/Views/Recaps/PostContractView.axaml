<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NenFocus.ViewModels.Recaps"
             xmlns:conv="using:NenFocus.Converters"
             x:DataType="vm:PostContractViewModel"
             x:Class="NenFocus.Views.Recaps.PostContractView"
             Background="#F5F5F7">

	<UserControl.Resources>
		<conv:HoursToStringConverter x:Key="HoursConverter"/>
		<conv:PercentageToLabelConverter x:Key="PercentageConverter"/>
		<conv:DateTimeToStringConverter x:Key="DateConverter"/>
	</UserControl.Resources>

	<UserControl.Styles>

		<!-- Done button -->

		<!-- Reflection TextBox -->
		<Style Selector="TextBox.reflection">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#E0E0EE"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="14,12"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="#333344"/>
			<Setter Property="MinHeight" Value="80"/>
		</Style>

		<!-- Day-strip tile -->
		<Style Selector="Border.day-tile">
			<Setter Property="Background" Value="#F5F5FA"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="MinWidth" Value="56"/>
		</Style>

		<!-- Scrollbar hidden -->
		<Style Selector="ScrollViewer">
			<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
		</Style>

	</UserControl.Styles>

	<ScrollViewer>
		<StackPanel Margin="52,44,52,44" MaxWidth="600" Spacing="32">

			<!-- ── Header ─────────────────────────────────────── -->
			<StackPanel Spacing="8" HorizontalAlignment="Center">
				<TextBlock Text="✦"
                           FontSize="24"
                           Foreground="#B8922A"
                           HorizontalAlignment="Center"/>
				<TextBlock Text="{Binding HeaderLabel}"
                           FontSize="10"
                           FontWeight="Medium"
                           Foreground="#B8922A"
                           LetterSpacing="4"
                           HorizontalAlignment="Center"/>
			</StackPanel>

			<!-- ── Summary card ───────────────────────────────── -->
			<Border Background="#FFFFFF"
                    CornerRadius="14"
                    BorderBrush="#E8E8F0"
                    BorderThickness="1"
                    Padding="32,28">
				<StackPanel Spacing="20">

					<!-- Name -->
					<TextBlock Text="{Binding Name}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1A1A2E"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

					<TextBlock
                               FontSize="13"
                               Foreground="#888899"
                               HorizontalAlignment="Center">
						<TextBlock.Text>
							<MultiBinding Converter="{x:Static conv:DateRangeToLabelConverter.Instance}">
								<Binding Path="StartDate"/>
								<Binding Path="EndDate"/>
							</MultiBinding>
						</TextBlock.Text>
					</TextBlock>

					<!-- Divider -->
					<Border Height="1" Background="#EEEEF5"/>

					<!-- Stats grid -->
					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">

						<!-- Committed -->
						<StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,0,14">
							<TextBlock Text="COMMITTED"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       Foreground="#AAAABC"
                                       LetterSpacing="2"/>
							<TextBlock Text="{Binding CommittedFocusHours, Converter={StaticResource HoursConverter}}"
                                       FontSize="20"
                                       FontWeight="Light"
                                       Foreground="#1A1A2E"/>
						</StackPanel>

						<!-- Completed -->
						<StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,14">
							<TextBlock Text="COMPLETED"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       Foreground="#AAAABC"
                                       LetterSpacing="2"/>
							<TextBlock Text="{Binding TotalCompletedHours, Converter={StaticResource HoursConverter}}"
                                       FontSize="20"
                                       FontWeight="Light"
                                       Foreground="#1A1A2E"/>
						</StackPanel>

						<!-- Bonus -->
						<StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,0,0,14" IsVisible="{Binding HasBonusHours}">
							<TextBlock Text="BONUS"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       Foreground="#AAAABC"
                                       LetterSpacing="2"/>
							<TextBlock Text="{Binding TotalBonusHours, Converter={StaticResource HoursConverter}}"
                                       FontSize="20"
                                       FontWeight="Light"
                                       Foreground="#1A1A2E"/>
						</StackPanel>

						<!-- Best streak -->
						<StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,0,0,14" IsVisible="{Binding HasStreak}">
							<TextBlock Text="BEST STREAK"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       Foreground="#AAAABC"
                                       LetterSpacing="2"/>
							<TextBlock Text="{Binding BestStreakDays, StringFormat='{}{0} days'}"
                                       FontSize="20"
                                       FontWeight="Light"
                                       Foreground="#1A1A2E"/>
						</StackPanel>

						<!-- Grade -->
						<StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2" IsVisible="{Binding HasGrade}">
							<TextBlock Text="GRADE"
                                       FontSize="9"
                                       FontWeight="Medium"
                                       Foreground="#AAAABC"
                                       LetterSpacing="2"/>
							<TextBlock Text="{Binding CompletionGrade}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#B8922A"/>
						</StackPanel>

					</Grid>

				</StackPanel>
			</Border>

			<!-- ── Daily breakdown ────────────────────────────── -->
			<Border Background="#FFFFFF"
                    CornerRadius="14"
                    BorderBrush="#E8E8F0"
                    BorderThickness="1"
                    Padding="32,24"
                    IsVisible="{Binding HasDailyBreakdown}">
				<StackPanel Spacing="14">

					<TextBlock Text="DAY BY DAY"
                               FontSize="9"
                               FontWeight="Medium"
                               Foreground="#AAAABC"
                               LetterSpacing="2"/>

					<ItemsControl ItemsSource="{Binding DailyBreakdownItems}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="vm:DailyRecapItemViewModel">
								<Border Classes="day-tile" Margin="0,0,8,8">
									<StackPanel Spacing="2" HorizontalAlignment="Center">
										<TextBlock Text="{Binding Date, Converter={StaticResource DateConverter}, ConverterParameter='MMM d'}"
                                                   FontSize="10"
                                                   Foreground="#AAAABC"
                                                   HorizontalAlignment="Center"/>
										<TextBlock Text="{Binding Percentage, Converter={StaticResource PercentageConverter}}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="#555566"
                                                   HorizontalAlignment="Center"/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

				</StackPanel>
			</Border>

			<!-- ── Block breakdown ────────────────────────────── -->
			<Border Background="#FFFFFF"
                    CornerRadius="14"
                    BorderBrush="#E8E8F0"
                    BorderThickness="1"
                    Padding="32,24">
				<StackPanel Spacing="14">

					<TextBlock Text="BLOCKS"
                               FontSize="9"
                               FontWeight="Medium"
                               Foreground="#AAAABC"
                               LetterSpacing="2"/>

					<Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">

						<StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,0,12">
							<TextBlock Text="ON TIME" FontSize="9" Foreground="#AAAABC" LetterSpacing="1"/>
							<TextBlock Text="{Binding CompletedOnTimeBlocks}" FontSize="16" FontWeight="Light" Foreground="#1A1A2E"/>
						</StackPanel>

						<StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,12">
							<TextBlock Text="LATE" FontSize="9" Foreground="#AAAABC" LetterSpacing="1"/>
							<TextBlock Text="{Binding StartedLateBlocks}" FontSize="16" FontWeight="Light" Foreground="#1A1A2E"/>
						</StackPanel>

						<StackPanel Grid.Row="0" Grid.Column="2" Spacing="2" Margin="0,0,0,12">
							<TextBlock Text="MISSED" FontSize="9" Foreground="#AAAABC" LetterSpacing="1"/>
							<TextBlock Text="{Binding MissedBlocks}" FontSize="16" FontWeight="Light" Foreground="#1A1A2E"/>
						</StackPanel>

						<StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
							<TextBlock Text="REDEMPTION" FontSize="9" Foreground="#AAAABC" LetterSpacing="1"/>
							<TextBlock Text="{Binding RedemptionBlocks}" FontSize="16" FontWeight="Light" Foreground="#1A1A2E"/>
						</StackPanel>

						<StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
							<TextBlock Text="BONUS" FontSize="9" Foreground="#AAAABC" LetterSpacing="1"/>
							<TextBlock Text="{Binding BonusBlockCount}" FontSize="16" FontWeight="Light" Foreground="#1A1A2E"/>
						</StackPanel>

						<StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
							<TextBlock Text="CANCELLED" FontSize="9" Foreground="#AAAABC" LetterSpacing="1"/>
							<TextBlock Text="{Binding CancelledBlocks}" FontSize="16" FontWeight="Light" Foreground="#1A1A2E"/>
						</StackPanel>

					</Grid>

				</StackPanel>
			</Border>

			<!-- ── Reflection ─────────────────────────────────── -->
			<Border Background="#FFFFFF"
                    CornerRadius="14"
                    BorderBrush="#E8E8F0"
                    BorderThickness="1"
                    Padding="32,24">
				<StackPanel Spacing="12">

					<TextBlock Text="REFLECTION"
                               FontSize="9"
                               FontWeight="Medium"
                               Foreground="#AAAABC"
                               LetterSpacing="2"/>

					<TextBlock Text="{Binding ReflectionPrompt}"
                               FontSize="13"
                               Foreground="#BBBBCC"
                               FontStyle="Italic"/>

					<TextBox Classes="reflection"
                             Text="{Binding ReflectionText}"
                             Watermark="Write a quick note..."
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>

				</StackPanel>
			</Border>

			<!-- ── Done button ────────────────────────────────── -->
			<Button Classes="done-btn"
                    Command="{Binding DoneCommand}">
				<TextBlock Text="DONE"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#B8922A"
                           LetterSpacing="3"/>
			</Button>

			<!-- Bottom spacing -->
			<Border Height="20"/>

		</StackPanel>
	</ScrollViewer>

</UserControl>
