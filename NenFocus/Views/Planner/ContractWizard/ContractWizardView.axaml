<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NenFocus.ViewModels.Planner.ContractWizard"
             xmlns:conv="using:NenFocus.Converters"
             x:DataType="vm:ContractWizardViewModel"
             x:Class="NenFocus.Views.Planner.ContractWizard.ContractWizardView"
             Background="#FAFAF8">

    <UserControl.Styles>
    </UserControl.Styles>

    <!-- Overlay fills the whole window (set by ShellView's ContentControl, same as Ritual);
         only the step content below is width-capped for readability. -->
    <Grid RowDefinitions="40,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Grid Grid.Row="0" ColumnDefinitions="80,*,80" Margin="28,0">
            <Button Grid.Column="0"
                    Classes="back-btn"
                    IsVisible="{Binding IsBackVisible}"
                    VerticalAlignment="Center"
                    Command="{Binding GoBackCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="✕" FontSize="14" Foreground="#7A7A8C" IsVisible="{Binding IsDot0Active}"/>
                    <TextBlock Text="Cancel" FontSize="13" Foreground="#7A7A8C" IsVisible="{Binding IsDot0Active}"/>
                    <TextBlock Text="←" FontSize="14" Foreground="#7A7A8C" IsVisible="{Binding !IsDot0Active}"/>
                    <TextBlock Text="Back" FontSize="13" Foreground="#7A7A8C" IsVisible="{Binding !IsDot0Active}"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <Ellipse Width="7" Height="7" Fill="{Binding IsDot0Active, Converter={x:Static conv:BoolToDotFillConverter.Instance}}"/>
                <Ellipse Width="7" Height="7" Fill="{Binding IsDot1Active, Converter={x:Static conv:BoolToDotFillConverter.Instance}}"/>
                <Ellipse Width="7" Height="7" Fill="{Binding IsDot2Active, Converter={x:Static conv:BoolToDotFillConverter.Instance}}"/>
                <Ellipse Width="7" Height="7" Fill="{Binding IsDot3Active, Converter={x:Static conv:BoolToDotFillConverter.Instance}}"/>
            </StackPanel>
        </Grid>

        <TransitioningContentControl Grid.Row="1"
                                      Content="{Binding CurrentStep}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      MaxWidth="640">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.25"/>
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

    </Grid>
</UserControl>
