<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NenFocus.ViewModels.Pages"
             xmlns:comp="using:NenFocus.ViewModels.Components"
             xmlns:dto="using:NenFocus.Application.DTOs"
             xmlns:conv="using:NenFocus.Converters"
             x:DataType="vm:PlannerPageViewModel"
             x:Class="NenFocus.Views.PlannerPageView"
             Background="#F5F5F7">

	<UserControl.Resources>
		<conv:WeekRangeToStringConverter x:Key="WeekRangeConverter"/>
		<conv:DateTimeToUpperStringConverter x:Key="DateTimeUpperConverter"/>
		<conv:DurationToStringConverter x:Key="DurationConverter"/>
		<conv:DurationLabelConverter x:Key="DurationLabelConverter"/>
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="Border.dayHeader">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#E6E6EE"/>
			<Setter Property="BorderThickness" Value="0,0,1,1"/>
			<Setter Property="Padding" Value="0,10"/>
		</Style>
		<Style Selector="Border.dayHeader.today">
			<Setter Property="Background" Value="#FFF8E5"/>
		</Style>

		<Style Selector="Border.hourLabel">
			<Setter Property="Height" Value="56"/>
			<Setter Property="BorderBrush" Value="#E6E6EE"/>
			<Setter Property="BorderThickness" Value="0,0,1,0"/>
			<Setter Property="Padding" Value="8,0"/>
		</Style>

		<Style Selector="Button.hourCell">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#EEEEF2"/>
			<Setter Property="BorderThickness" Value="0,0,1,1"/>
			<Setter Property="Height" Value="56"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Stretch"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.hourCell:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#F0F0F8"/>
		</Style>

		<Style Selector="Button.blockTile">
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Top"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.focusTile">
			<Setter Property="Background" Value="#B8922A"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="Button.backgroundTile">
			<Setter Property="Background" Value="#E8E8F0"/>
			<Setter Property="Foreground" Value="#1A1A2E"/>
		</Style>
		<Style Selector="Button.missedTile">
			<Setter Property="Background" Value="#C0392B"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="Button.lateOrEarlyTile">
			<Setter Property="Background" Value="#D97706"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="Button.completedOnTimeTile">
			<Setter Property="Background" Value="#3A9E6A"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="Button.blockTile:pointerover /template/ ContentPresenter">
			<Setter Property="Opacity" Value="0.85"/>
		</Style>

		<Style Selector="Button.navButton">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#DDDDE8"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="10,6"/>
			<Setter Property="Foreground" Value="#1A1A2E"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.navButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#F0F0F8"/>
		</Style>

		<Style Selector="Button.todayButton">
			<Setter Property="Background" Value="#1A1A2E"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="14,6"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="TextBox.formInput">
			<Setter Property="Background" Value="#F8F8FB"/>
			<Setter Property="BorderBrush" Value="#DDDDE8"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="10,8"/>
		</Style>

		<Style Selector="Button.primary">
			<Setter Property="Background" Value="#1A1A2E"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="16,8"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.secondary">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#1A1A2E"/>
			<Setter Property="BorderBrush" Value="#DDDDE8"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="14,8"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.bannerCancelBtn">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#7A7A8C"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.bannerCancelBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#F8DAD6"/>
		</Style>
		<Style Selector="Button.bannerCancelBtn:pointerover">
			<Setter Property="Foreground" Value="#C03A2B"/>
		</Style>

		<Style Selector="Button.danger">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#C03A2B"/>
			<Setter Property="BorderBrush" Value="#E8C0BA"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="14,8"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="Button.typePill">
			<Setter Property="Background" Value="#F0F0F8"/>
			<Setter Property="Foreground" Value="#1A1A2E"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="14,8"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.typePill.active">
			<Setter Property="Background" Value="#B8922A"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<Style Selector="Button.coverDeficitBtn">
			<Setter Property="Background" Value="#FDECEA"/>
			<Setter Property="Foreground" Value="#C0392B"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="10,6"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style Selector="TextBlock.snapshotSectionLabel">
			<Setter Property="FontSize" Value="9"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="LetterSpacing" Value="4"/>
			<Setter Property="Foreground" Value="#AAAABC"/>
		</Style>
		<Style Selector="Border.snapshotBadge">
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="8,3"/>
		</Style>
		<!-- Wraps the Start/End AutoCompleteBox rather than reaching into its own control
		     template — a template-part selector on AutoCompleteBox's internal TextBox
		     turned out not to render reliably (Fluent theme's own template structure isn't
		     something to guess at without visually confirming it). A plain Border around
		     the control is unaffected by any of that. -->
		<Style Selector="Border.invalid">
			<Setter Property="BorderBrush" Value="#C03A2B"/>
			<Setter Property="BorderThickness" Value="2"/>
		</Style>

		<!-- Google-Calendar-style capped dropdown height, applied to all six time
		     AutoCompleteBoxes on this page (Form Start/End + Split's four fields) — the
		     only AutoCompleteBox instances in this view, so one page-wide selector covers
		     them without touching each instance. AutoCompleteBox's own default
		     MaxDropDownHeight is Infinity (confirmed via reflection on the registered
		     StyledProperty), which is why the popup was growing to fit every item.
		     196 replaces an earlier 171 that was derived from a headless Avalonia layout
		     pass claiming 33px rows — that number turned out wrong for the real running
		     app (see Open Gap L / DESIGN_GAP_HISTORY.md Gap 37/38): live diagnostic logging
		     (Extent.Height / ItemCount, confirmed identical and exact for both Start's plain
		     string items and End's TimeText+Duration template) showed rows actually render
		     at 38px, and the popup's outer chrome (a Border with BorderThickness 1 and
		     Padding 0,2,0,2 around the ListBox) adds a fixed 6px — confirmed via 8 repeated
		     LayoutUpdated ticks per open, Viewport rock-steady the whole time, so this isn't
		     a still-settling number. 5 * 38 + 6 = 196, landing the ScrollViewer's viewport
		     at exactly 190px (5 whole rows, no partial 6th row).
		     The inner ScrollViewer's VerticalScrollBarVisibility already defaults to Auto
		     in AutoCompleteBox's stock template, so capping the height alone is enough to
		     make the scrollbar appear for the remaining items — no retemplating needed. -->
		<Style Selector="AutoCompleteBox">
			<Setter Property="MaxDropDownHeight" Value="196"/>
		</Style>
	</UserControl.Styles>

	<Grid>
		<Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">

			<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
				<StackPanel Grid.Column="0" Spacing="2">
					<TextBlock Text="Planner" FontSize="22" FontWeight="SemiBold" Foreground="#1A1A2E"/>
					<TextBlock Text="{Binding WeekStart, Converter={StaticResource WeekRangeConverter}}" FontSize="13" Foreground="#7A7A8C"/>
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<Button Classes="navButton" Content="‹" Command="{Binding PreviousWeekCommand}"/>
					<Button Classes="todayButton" Content="Today" Command="{Binding GoToTodayCommand}"/>
					<Button Classes="navButton" Content="›" Command="{Binding NextWeekCommand}"/>
					<Button Name="NenContractButton" Classes="primary" Content="Nen Contract"
                            Command="{Binding ToggleNenContractPopoverCommand}"
                            IsVisible="{Binding !IsDraftingContract}"
                            Margin="8,0,0,0"/>
				</StackPanel>
			</Grid>

			<Border Grid.Row="1"
                    IsVisible="{Binding HasActiveContract}"
                    Background="#F0F0F8"
                    BorderBrush="#DDDDE8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,16">
				<Grid ColumnDefinitions="*,Auto,Auto">
					<StackPanel Grid.Column="0" Spacing="4">
						<TextBlock Text="{Binding ActiveContractBannerText}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A2E"/>
						<TextBlock Text="{Binding CancelContractErrorMessage}"
                                   IsVisible="{Binding CancelContractErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="12" Foreground="#C03A2B" TextWrapping="Wrap"/>
						<TextBlock Text="{Binding CoverDeficitErrorMessage}"
                                   IsVisible="{Binding CoverDeficitErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="12" Foreground="#C03A2B" TextWrapping="Wrap"/>
					</StackPanel>
					<Button Name="CoverDeficitButton" Grid.Column="1"
                            Classes="coverDeficitBtn"
                            Content="Cover Deficit"
                            ToolTip.Tip="Create a tile to cover an outstanding deficit"
                            Command="{Binding ToggleCoverDeficitPopoverCommand}"
                            IsVisible="{Binding HasCoverableDeficit}"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"/>
					<Button Grid.Column="2"
                            Classes="bannerCancelBtn"
                            Content="✕"
                            ToolTip.Tip="Cancel contract"
                            Command="{Binding RequestCancelContractCommand}"
                            IsVisible="{Binding CanCancelActiveContract}"
                            VerticalAlignment="Center"/>
				</Grid>
			</Border>

			<Popup IsOpen="{Binding IsCoverDeficitPopoverVisible, Mode=TwoWay}"
                   PlacementTarget="{Binding #CoverDeficitButton}"
                   Placement="BottomEdgeAlignedRight"
                   IsLightDismissEnabled="True"
                   VerticalOffset="6">
				<Border Background="#FFFFFF" BorderBrush="#DDDDE8" BorderThickness="1" CornerRadius="12"
                        Width="320" Padding="14" BoxShadow="0 12 40 0 #33000000">
					<StackPanel Spacing="8">
						<TextBlock Text="Cover which deficit?" FontSize="12" FontWeight="Medium" Foreground="#888899"/>
						<ItemsControl ItemsSource="{Binding CoverDeficitOptions}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Spacing="6"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="dto:SuggestedRedemptionPlacementDto">
									<Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Command="{Binding $parent[UserControl].((vm:PlannerPageViewModel)DataContext).CoverDeficitCommand}"
                                            CommandParameter="{Binding}">
										<StackPanel Spacing="2">
											<TextBlock Text="{Binding PresetName}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A2E"/>
											<TextBlock Text="{Binding TotalRemainingDeficitMinutes, StringFormat='{}{0:0.#} min owed'}" FontSize="11" Foreground="#888899"/>
										</StackPanel>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>
			</Popup>

			<Border Grid.Row="2"
                    IsVisible="{Binding IsDraftingContract}"
                    Background="#FFF8E5"
                    BorderBrush="#B8922A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,16">
				<Grid ColumnDefinitions="*,Auto">
					<StackPanel Grid.Column="0" Spacing="6">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<TextBlock Text="Drafting:" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A2E"/>
							<TextBlock Text="{Binding DraftContractName}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A2E"/>
						</StackPanel>
						<TextBlock Text="{Binding DraftFloorSummaryText}" FontSize="12" Foreground="#5A5A6C"
                                   IsVisible="{Binding DraftFloorSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						<TextBlock Text="{Binding SealErrorMessage}"
                                   IsVisible="{Binding SealErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="12" Foreground="#C03A2B" TextWrapping="Wrap"/>
					</StackPanel>
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<Button Classes="secondary" Content="Cancel" Command="{Binding RequestCancelDraftCommand}"/>
						<Button Classes="primary" Content="Seal Contract" Command="{Binding SealContractCommand}" IsEnabled="{Binding !IsSealing}"/>
					</StackPanel>
				</Grid>
			</Border>

			<Border Grid.Row="3"
                    Background="#FFFFFF"
                    BorderBrush="#E6E6EE"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">
				<Grid RowDefinitions="Auto,Auto,*">

					<Grid Grid.Row="0" ColumnDefinitions="64,*,*,*,*,*,*,*">
						<Border Grid.Column="0" Classes="dayHeader" BorderThickness="0,0,1,0"/>
						<ItemsControl Grid.Column="1" Grid.ColumnSpan="7" ItemsSource="{Binding DayHeaders}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Rows="1"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="comp:WeekDayHeaderViewModel">
									<Border Classes="dayHeader" Classes.today="{Binding IsToday}">
										<StackPanel HorizontalAlignment="Center" Spacing="2">
											<TextBlock Text="{Binding Date, Converter={StaticResource DateTimeUpperConverter}, ConverterParameter='ddd'}" FontSize="11" FontWeight="Medium" Foreground="#7A7A8C" HorizontalAlignment="Center"/>
											<TextBlock Text="{Binding Date.Day}" FontSize="18" FontWeight="SemiBold" Foreground="#1A1A2E" HorizontalAlignment="Center"/>
											<Border Background="{Binding DayFloorStatus, Converter={x:Static conv:DayFloorStatusToBrushConverter.Instance}}"
                                                    IsVisible="{Binding DayFloorStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    CornerRadius="3" Padding="5,2" Margin="0,2,0,0">
												<TextBlock Text="{Binding DayFloorStatus.Label}"
                                                           Foreground="{Binding DayFloorStatus, Converter={x:Static conv:DayFloorStatusToForegroundConverter.Instance}}"
                                                           FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
											</Border>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Grid>

					<Border Grid.Row="1"
                            Background="#FFF0F0"
                            BorderBrush="#E8C0BA"
                            BorderThickness="0,0,0,1"
                            Padding="12,8"
                            IsVisible="{Binding DragError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
						<TextBlock Text="{Binding DragError}" FontSize="12" Foreground="#C03A2B" TextWrapping="Wrap"/>
					</Border>

					<ScrollViewer Grid.Row="2" Name="GridScroller" VerticalScrollBarVisibility="Auto">
						<Grid ColumnDefinitions="64,*,*,*,*,*,*,*">
							<ItemsControl Grid.Column="0" ItemsSource="{Binding HourLabels}">
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="comp:HourLabelViewModel">
										<Border Classes="hourLabel">
											<TextBlock Text="{Binding Label}" IsVisible="{Binding IsIntermediate}" FontSize="11" Foreground="#7A7A8C" VerticalAlignment="Top" Margin="0,0,0,0"/>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Grid Grid.Column="1" Name="DayCol0"/>
							<Grid Grid.Column="2" Name="DayCol1"/>
							<Grid Grid.Column="3" Name="DayCol2"/>
							<Grid Grid.Column="4" Name="DayCol3"/>
							<Grid Grid.Column="5" Name="DayCol4"/>
							<Grid Grid.Column="6" Name="DayCol5"/>
							<Grid Grid.Column="7" Name="DayCol6"/>

							<Canvas Grid.Column="{Binding TodayColumnIndex}"
							IsVisible="{Binding IsTodayInView}"
							IsHitTestVisible="False"
							ZIndex="100">
								<Grid Canvas.Top="{Binding CurrentTimeY}"
									  Width="{Binding $parent[Canvas].Bounds.Width}"
									  Height="2">
									<Rectangle Fill="#EA4335" Height="2" HorizontalAlignment="Stretch"/>
									<Ellipse Fill="#EA4335" Width="12" Height="12" Margin="-6,-5,0,0" HorizontalAlignment="Left"/>
								</Grid>
							</Canvas>
						</Grid>
					</ScrollViewer>
				</Grid>
			</Border>

		</Grid>

		<Border Background="#80FFFFFF"
                IsVisible="{Binding IsLoading}"
                IsHitTestVisible="{Binding IsLoading}">
			<TextBlock Text="Loading…" FontSize="14" Foreground="#7A7A8C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		</Border>

		<Border Background="#80000000"
                IsVisible="{Binding IsFormVisible}"
                IsHitTestVisible="{Binding IsFormVisible}">
			<Border Background="White" CornerRadius="12" Padding="24" Width="480" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
				<Grid RowDefinitions="Auto,*,Auto">
					<StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
						<TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#1A1A2E"/>
						<TextBlock Text="Schedule a block of focused or background time." FontSize="12" Foreground="#7A7A8C"/>
					</StackPanel>

					<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
						<StackPanel Spacing="14">
							<StackPanel Spacing="4">
								<TextBlock Text="Type" FontSize="12" Foreground="#7A7A8C"/>
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Button Classes="typePill" Classes.active="{Binding IsFocusBlock}" Content="Focus" Command="{Binding SetFocusBlockCommand}" IsEnabled="{Binding !IsBlockLocked}"/>
									<Button Classes="typePill" Classes.active="{Binding !IsFocusBlock}" Content="Background" Command="{Binding SetBackgroundBlockCommand}" IsEnabled="{Binding !IsBlockLocked}"/>
								</StackPanel>
							</StackPanel>

							<StackPanel Spacing="4">
								<TextBlock Text="Date" FontSize="12" Foreground="#7A7A8C"/>
								<DatePicker SelectedDate="{Binding FormDate}" IsEnabled="{Binding !IsBlockLocked}"/>
							</StackPanel>

							<Grid ColumnDefinitions="*,12,*">
								<StackPanel Grid.Column="0" Spacing="4">
									<TextBlock Text="Start" FontSize="12" Foreground="#7A7A8C"/>
									<Border Classes.invalid="{Binding IsFormStartTimeInvalid}" CornerRadius="6">
										<AutoCompleteBox Name="FormStartTimeBox"
                                                         ItemsSource="{Binding VisibleStartTimeOptions}"
                                                         Text="{Binding FormStartTime, Mode=TwoWay}"
                                                         FilterMode="Custom"
                                                         MinimumPrefixLength="0"
                                                         Watermark="HH:mm"
                                                         IsEnabled="{Binding !IsStartLocked}"/>
									</Border>
								</StackPanel>
								<StackPanel Grid.Column="2" Spacing="4">
									<TextBlock Text="End" FontSize="12" Foreground="#7A7A8C"/>
									<Border Classes.invalid="{Binding IsFormEndTimeInvalid}" CornerRadius="6">
										<AutoCompleteBox Name="FormEndTimeBox"
                                                         ItemsSource="{Binding VisibleEndTimeOptions}"
                                                         ValueMemberBinding="{Binding TimeText}"
                                                         Text="{Binding FormEndTime, Mode=TwoWay}"
                                                         FilterMode="Custom"
                                                         MinimumPrefixLength="0"
                                                         Watermark="HH:mm"
                                                         IsEnabled="{Binding !IsBlockLocked}">
											<AutoCompleteBox.ItemTemplate>
												<DataTemplate DataType="comp:PlannerEndTimeOptionDto">
													<StackPanel Orientation="Horizontal" Spacing="6">
														<TextBlock Text="{Binding TimeText}"/>
														<TextBlock Text="{Binding Duration, Converter={StaticResource DurationLabelConverter}}"
                                                                   Opacity="0.6" FontSize="11"/>
													</StackPanel>
												</DataTemplate>
											</AutoCompleteBox.ItemTemplate>
										</AutoCompleteBox>
									</Border>
									<TextBlock Text="{Binding FormEndDateText}"
                                               IsVisible="{Binding FormEndRollsToNextDay}"
                                               FontSize="11" Foreground="#7A7A8C" FontStyle="Italic"/>
								</StackPanel>
							</Grid>

							<StackPanel Spacing="4">
								<TextBlock Text="Block Preset" FontSize="12" Foreground="#7A7A8C"/>
								<ComboBox ItemsSource="{Binding AvailablePresets}"
                                          SelectedItem="{Binding SelectedPreset}"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="{Binding !IsBlockLocked}">
									<ComboBox.ItemTemplate>
										<DataTemplate DataType="dto:BlockPresetDto">
											<TextBlock Text="{Binding Name}"/>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
								<TextBlock Text="{Binding RedemptionSuggestionNotice}"
                                           IsVisible="{Binding RedemptionSuggestionNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           FontSize="11" Foreground="#B8860B" TextWrapping="Wrap"/>
							</StackPanel>

							<TextBlock Text="{Binding FormError}"
                                       IsVisible="{Binding FormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="12" Foreground="#C03A2B" TextWrapping="Wrap"/>
						</StackPanel>
					</ScrollViewer>

					<Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,16,0,0">
						<Button Grid.Column="0" Classes="danger" Content="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDeleteFromForm}"/>
						<Button Grid.Column="1" Classes="secondary" Content="Split Block" Command="{Binding OpenSplitDialogCommand}" IsVisible="{Binding CanSplitBlock}" Margin="8,0,0,0"/>
						<Button Grid.Column="3" Classes="secondary" Content="Cancel" Command="{Binding CloseFormCommand}"/>
						<Button Grid.Column="4" Classes="primary" Content="{Binding SaveButtonLabel}" Command="{Binding SaveCommand}" Margin="8,0,0,0" IsVisible="{Binding CanSaveBlock}"/>
					</Grid>
				</Grid>
			</Border>
		</Border>

		<Border Background="#80000000"
                IsVisible="{Binding IsSnapshotVisible}"
                IsHitTestVisible="{Binding IsSnapshotVisible}">
			<Border Background="White" CornerRadius="12" Width="520" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 48 0 #44000000">
				<Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding SnapshotBlock, Converter={x:Static ObjectConverters.IsNotNull}}">

					<StackPanel Grid.Row="0" Spacing="10" Margin="24,24,24,16">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Border Classes="snapshotBadge" Background="{Binding SnapshotBlock.BlockPresetType, Converter={x:Static conv:BlockPresetTypeToColorConverter.Instance}}">
								<TextBlock Text="{Binding SnapshotBlock.BlockPresetType, Converter={x:Static conv:BlockPresetTypeToLabelConverter.Instance}}"
                                           FontSize="10" FontWeight="Medium" LetterSpacing="1"
                                           Foreground="{Binding SnapshotBlock.BlockPresetType, Converter={x:Static conv:BlockPresetTypeToForegroundConverter.Instance}}"/>
							</Border>
							<Border Classes="snapshotBadge"
                                    Background="{Binding SnapshotBlock.Outcome, Converter={x:Static conv:FocusBlockOutcomeToBrushConverter.Instance}}"
                                    IsVisible="{Binding SnapshotBlock.Outcome, Converter={x:Static ObjectConverters.IsNotNull}}">
								<TextBlock Text="{Binding SnapshotBlock.Outcome, Converter={x:Static conv:FocusBlockOutcomeToLabelConverter.Instance}}"
                                           FontSize="10" FontWeight="Medium" LetterSpacing="1" Foreground="White"/>
							</Border>
							<Border Classes="snapshotBadge" Background="#F5EDD8"
                                    IsVisible="{Binding SnapshotBlock.ContractBadge, Converter={x:Static conv:EnumEqualConverter.Instance}, ConverterParameter=Redemption}">
								<TextBlock Text="REDEMPTION" FontSize="10" FontWeight="Medium" LetterSpacing="1" Foreground="#8B7320"/>
							</Border>
						</StackPanel>

						<TextBlock Text="{Binding SnapshotBlock.PresetName}" FontSize="18" FontWeight="SemiBold" Foreground="#1A1A2E"/>

						<TextBlock FontSize="13" Foreground="#7A7A8C">
							<Run Text="{Binding SnapshotBlock.Start, StringFormat='{}{0:MMMM d, yyyy}', Mode=OneWay}"/>
							<Run Text=" · "/>
							<Run Text="{Binding SnapshotBlock.Start, StringFormat='{}{0:h:mm tt}', Mode=OneWay}"/>
							<Run Text=" – "/>
							<Run Text="{Binding SnapshotBlock.End, StringFormat='{}{0:h:mm tt}', Mode=OneWay}"/>
							<Run Text=" ("/>
							<Run Text="{Binding SnapshotBlock.Duration, Converter={StaticResource DurationConverter}, Mode=OneWay}"/>
							<Run Text=")"/>
						</TextBlock>
					</StackPanel>

					<Border Grid.Row="1" Height="1" Background="#E8E8F0" Margin="24,0"/>

					<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="24,16,24,16">
						<StackPanel Spacing="18">

							<TextBlock Text="No session was started during this block."
                                       IsVisible="{Binding ShowSnapshotNoSessionMessage}"
                                       FontSize="13" Foreground="#7A7A8C" FontStyle="Italic"/>

							<StackPanel Spacing="18" IsVisible="{Binding HasSnapshotSession}">

								<StackPanel Spacing="4">
									<TextBlock Text="ZETSU GOAL" Classes="snapshotSectionLabel"/>
									<TextBlock Text="{Binding SnapshotSession.Goal}" FontSize="14" Foreground="#1A1A2E" TextWrapping="Wrap"/>
								</StackPanel>

								<StackPanel Spacing="4">
									<TextBlock Text="REFLECTION" Classes="snapshotSectionLabel"/>
									<TextBlock Text="{Binding SnapshotSession.Reflection}"
                                               IsVisible="{Binding SnapshotSession.Reflection, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               FontSize="14" Foreground="#1A1A2E" TextWrapping="Wrap"/>
									<TextBlock Text="No reflection was written."
                                               IsVisible="{Binding SnapshotSession.Reflection, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                               FontSize="13" Foreground="#AAAABC" FontStyle="Italic"/>
								</StackPanel>

								<StackPanel Spacing="6" IsVisible="{Binding SnapshotSession.RedemptionCoverage.Count, Converter={x:Static conv:CountToBoolConverter.IsNonZero}}">
									<TextBlock Text="COVERED A MISSED BLOCK" Classes="snapshotSectionLabel"/>
									<ItemsControl ItemsSource="{Binding SnapshotSession.RedemptionCoverage}">
										<ItemsControl.ItemTemplate>
											<DataTemplate DataType="dto:RedemptionCoverageDto">
												<TextBlock FontSize="13" Foreground="#1A1A2E" Margin="0,2" TextWrapping="Wrap">
													<Run Text="{Binding MinutesCovered, Converter={x:Static conv:MinutesToStringConverter.Instance}, Mode=OneWay}"/>
													<Run Text=" of "/>
													<Run Text="{Binding MissedBlockPresetName, Mode=OneWay}"/>
													<Run Text=" missed on "/>
													<Run Text="{Binding MissedBlockDate, StringFormat='{}{0:MMM d, yyyy}', Mode=OneWay}"/>
												</TextBlock>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>

								<StackPanel Spacing="6">
									<TextBlock Text="BLOCKED ATTEMPTS" Classes="snapshotSectionLabel"/>
									<TextBlock Text="No blocked attempts during this block."
                                               IsVisible="{Binding SnapshotSession.Attempts.Count, Converter={x:Static conv:CountToBoolConverter.IsZero}}"
                                               FontSize="13" Foreground="#AAAABC" FontStyle="Italic"/>
									<Expander Header="{Binding SnapshotSession.Attempts.Count, StringFormat='{}{0} blocked attempts'}"
                                              IsVisible="{Binding SnapshotSession.Attempts.Count, Converter={x:Static conv:CountToBoolConverter.IsNonZero}}">
										<ItemsControl ItemsSource="{Binding SnapshotSession.Attempts}" Margin="0,8,0,0">
											<ItemsControl.ItemTemplate>
												<DataTemplate DataType="dto:BlockedAttemptSnapshotDto">
													<Grid ColumnDefinitions="52,*,Auto" Margin="0,4">
														<TextBlock Grid.Column="0" Text="{Binding AttemptType}" FontSize="11" Foreground="#AAAABC"/>
														<TextBlock Grid.Column="1" Text="{Binding ResourceName}" FontSize="13" Foreground="#1A1A2E" Margin="8,0"/>
														<TextBlock Grid.Column="2" Text="{Binding OccurredAt, StringFormat='{}{0:h:mm tt}'}" FontSize="12" Foreground="#7A7A8C"/>
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Expander>
								</StackPanel>

							</StackPanel>
						</StackPanel>
					</ScrollViewer>

					<StackPanel Grid.Row="3" Spacing="8" Margin="24,0,24,24">
						<TextBlock Text="{Binding DeleteSnapshotErrorMessage}"
                                   IsVisible="{Binding DeleteSnapshotErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="12" Foreground="#C03A2B" TextWrapping="Wrap"/>
						<Grid ColumnDefinitions="Auto,*,Auto">
							<Button Grid.Column="0" Classes="danger" Content="Delete" Command="{Binding RequestDeleteSnapshotBlockCommand}" IsVisible="{Binding CanDeleteSnapshotBlock}"/>
							<Button Grid.Column="2" Classes="primary" Content="Close" Command="{Binding CloseSnapshotCommand}"/>
						</Grid>
					</StackPanel>
				</Grid>
			</Border>
		</Border>

		<Border IsVisible="{Binding IsConfirmDeleteSnapshotVisible}" Background="#88000000">
			<Border Background="#FFFFFF" CornerRadius="14" Width="400" Padding="32,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 48 0 #44000000">
				<StackPanel Spacing="20">
					<TextBlock Text="Delete this block?" FontSize="18" FontWeight="SemiBold" Foreground="#1A1A2E"/>
					<TextBlock Text="This permanently removes it from the Planner, along with its session record. This cannot be undone."
                               FontSize="14" Foreground="#888899" TextWrapping="Wrap"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
						<Button Classes="secondary" Content="Keep It" Command="{Binding CancelDeleteSnapshotBlockCommand}"/>
						<Button Classes="danger" Content="Delete" Command="{Binding ConfirmDeleteSnapshotBlockCommand}"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>

		<Border IsVisible="{Binding IsSplitDialogVisible}" Background="#88000000">
			<Border Background="White" CornerRadius="12" Padding="24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 48 0 #44000000">
				<StackPanel Spacing="16">
					<StackPanel Spacing="4">
						<TextBlock Text="Split Block" FontSize="18" FontWeight="SemiBold" Foreground="#1A1A2E"/>
						<TextBlock Text="Choose the two resulting time ranges — both stay on the same day and must add up to the original block's duration."
                                   FontSize="12" Foreground="#7A7A8C" TextWrapping="Wrap"/>
					</StackPanel>

					<StackPanel Spacing="4">
						<TextBlock Text="First Block" FontSize="12" Foreground="#7A7A8C"/>
						<Grid ColumnDefinitions="*,12,*">
							<AutoCompleteBox Name="SplitFirstStartTimeBox" Grid.Column="0" ItemsSource="{Binding VisibleSplitFirstStartTimeOptions}"
                                              Text="{Binding SplitFirstStartTime, Mode=TwoWay}"
                                              FilterMode="Custom" MinimumPrefixLength="0" Watermark="HH:mm"/>
							<AutoCompleteBox Name="SplitFirstEndTimeBox" Grid.Column="2" ItemsSource="{Binding VisibleSplitFirstEndTimeOptions}"
                                              Text="{Binding SplitFirstEndTime, Mode=TwoWay}"
                                              FilterMode="Custom" MinimumPrefixLength="0" Watermark="HH:mm"/>
						</Grid>
					</StackPanel>

					<StackPanel Spacing="4">
						<TextBlock Text="Second Block" FontSize="12" Foreground="#7A7A8C"/>
						<Grid ColumnDefinitions="*,12,*">
							<AutoCompleteBox Name="SplitSecondStartTimeBox" Grid.Column="0" ItemsSource="{Binding VisibleSplitSecondStartTimeOptions}"
                                              Text="{Binding SplitSecondStartTime, Mode=TwoWay}"
                                              FilterMode="Custom" MinimumPrefixLength="0" Watermark="HH:mm"/>
							<AutoCompleteBox Name="SplitSecondEndTimeBox" Grid.Column="2" ItemsSource="{Binding VisibleSplitSecondEndTimeOptions}"
                                              Text="{Binding SplitSecondEndTime, Mode=TwoWay}"
                                              FilterMode="Custom" MinimumPrefixLength="0" Watermark="HH:mm"/>
						</Grid>
					</StackPanel>

					<TextBlock Text="{Binding SplitError}"
                               IsVisible="{Binding SplitError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12" Foreground="#C03A2B" TextWrapping="Wrap"/>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
						<Button Classes="secondary" Content="Cancel" Command="{Binding CloseSplitDialogCommand}"/>
						<Button Classes="primary" Content="Confirm Split" Command="{Binding ConfirmSplitCommand}"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>

		<Border IsVisible="{Binding IsConfirmDiscardDraftVisible}" Background="#88000000">
			<Border Background="#FFFFFF" CornerRadius="14" Width="400" Padding="32,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 48 0 #44000000">
				<StackPanel Spacing="20">
					<TextBlock Text="Discard Draft" FontSize="18" FontWeight="SemiBold" Foreground="#1A1A2E"/>
					<TextBlock Text="{Binding ConfirmDiscardDraftMessage}" FontSize="14" Foreground="#888899" TextWrapping="Wrap"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
						<Button Classes="secondary" Content="Keep Drafting" Command="{Binding CancelCancelDraftCommand}"/>
						<Button Classes="danger" Content="Discard" Command="{Binding ConfirmCancelDraftCommand}"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>

		<Border IsVisible="{Binding IsConfirmPartialRedemptionVisible}" Background="#88000000">
			<Border Background="#FFFFFF" CornerRadius="14" Width="400" Padding="32,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 48 0 #44000000">
				<StackPanel Spacing="20">
					<TextBlock Text="Won't Fully Cover" FontSize="18" FontWeight="SemiBold" Foreground="#1A1A2E"/>
					<TextBlock Text="{Binding ConfirmPartialRedemptionMessage}" FontSize="14" Foreground="#888899" TextWrapping="Wrap"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
						<Button Classes="secondary" Content="Cancel" Command="{Binding CancelPartialRedemptionCommand}"/>
						<Button Classes="primary" Content="Create Anyway" Command="{Binding ConfirmPartialRedemptionCommand}"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>

		<Border IsVisible="{Binding IsConfirmCreateRedemptionVisible}" Background="#88000000">
			<Border Background="#FFFFFF" CornerRadius="14" Width="400" Padding="32,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 48 0 #44000000">
				<StackPanel Spacing="20">
					<TextBlock Text="Link as Redemption?" FontSize="18" FontWeight="SemiBold" Foreground="#1A1A2E"/>
					<TextBlock Text="{Binding ConfirmCreateRedemptionMessage}" FontSize="14" Foreground="#888899" TextWrapping="Wrap"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
						<Button Classes="secondary" Content="Create as Bonus Block instead" Command="{Binding CreateAsBonusBlockCommand}"/>
						<Button Classes="primary" Content="Link as Redemption" Command="{Binding ConfirmCreateRedemptionCommand}"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>

		<Border IsVisible="{Binding IsConfirmCancelContractVisible}" Background="#88000000">
			<Border Background="#FFFFFF" CornerRadius="14" Width="400" Padding="32,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 48 0 #44000000">
				<StackPanel Spacing="20">
					<TextBlock Text="Cancel Contract" FontSize="18" FontWeight="SemiBold" Foreground="#1A1A2E"/>
					<TextBlock Text="{Binding ConfirmCancelContractMessage}" FontSize="14" Foreground="#888899" TextWrapping="Wrap"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
						<Button Classes="secondary" Content="Keep Contract" Command="{Binding CancelCancelContractCommand}"/>
						<Button Classes="danger" Content="Cancel Contract" Command="{Binding ConfirmCancelContractCommand}"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>

		<Border IsVisible="{Binding IsConfirmDeleteContractVisible}" Background="#88000000">
			<Border Background="#FFFFFF" CornerRadius="14" Width="400" Padding="32,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 12 48 0 #44000000">
				<StackPanel Spacing="20">
					<TextBlock Text="Delete Contract" FontSize="18" FontWeight="SemiBold" Foreground="#1A1A2E"/>
					<TextBlock Text="{Binding ConfirmDeleteContractMessage}" FontSize="14" Foreground="#888899" TextWrapping="Wrap"/>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
						<Button Classes="secondary" Content="Keep It" Command="{Binding CancelDeleteContractCommand}"/>
						<Button Classes="danger" Content="Delete" Command="{Binding ConfirmDeleteContractCommand}"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>

		<Popup IsOpen="{Binding IsNenContractPopoverVisible, Mode=TwoWay}"
               PlacementTarget="{Binding #NenContractButton}"
               Placement="BottomEdgeAlignedRight"
               IsLightDismissEnabled="True"
               VerticalOffset="6">
			<Border Background="#FFFFFF" BorderBrush="#DDDDE8" BorderThickness="1" CornerRadius="12"
                    Width="360" Padding="18" BoxShadow="0 12 40 0 #33000000">
				<StackPanel Spacing="16">

					<TextBlock Text="No active contracts" FontSize="13" Foreground="#888899"
                               IsVisible="{Binding HasNoContracts}"/>

					<StackPanel Spacing="8" IsVisible="{Binding HasActiveContract}">
						<TextBlock Text="ACTIVE" FontSize="10" FontWeight="Medium" LetterSpacing="1" Foreground="#AAAABC"/>
						<Border Background="#F0F0F8" CornerRadius="8" Padding="12,10">
							<Grid ColumnDefinitions="*,Auto">
								<StackPanel Grid.Column="0" Spacing="4">
									<TextBlock Text="{Binding ActiveContract.Name}" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A2E"/>
									<StackPanel Orientation="Horizontal" Spacing="4">
										<TextBlock Text="{Binding ActiveContract.StartDate, StringFormat='{}{0:MMM d}'}" FontSize="12" Foreground="#888899"/>
										<TextBlock Text="–" FontSize="12" Foreground="#888899"/>
										<TextBlock Text="{Binding ActiveContract.EndDate, StringFormat='{}{0:MMM d, yyyy}'}" FontSize="12" Foreground="#888899"/>
									</StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Border Background="#B8922A" CornerRadius="4" Padding="6,2">
											<TextBlock Text="Active" FontSize="10" FontWeight="Medium" Foreground="White"/>
										</Border>
										<TextBlock Text="{Binding ActiveContract.StrictnessRule, Converter={x:Static conv:StrictnessRuleToLabelConverter.Instance}}"
                                                   FontSize="12" Foreground="#888899"/>
									</StackPanel>
									<TextBlock Text="{Binding CancelContractErrorMessage}"
                                               IsVisible="{Binding CancelContractErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               FontSize="11" Foreground="#C03A2B" TextWrapping="Wrap"/>
								</StackPanel>
								<Button Grid.Column="1" Classes="bannerCancelBtn" Content="✕"
                                        ToolTip.Tip="Cancel contract"
                                        Command="{Binding RequestCancelContractCommand}"
                                        IsVisible="{Binding CanCancelActiveContract}"
                                        VerticalAlignment="Top"/>
							</Grid>
						</Border>
					</StackPanel>

					<StackPanel Spacing="8" IsVisible="{Binding ScheduledContracts.Count}">
						<TextBlock Text="UPCOMING" FontSize="10" FontWeight="Medium" LetterSpacing="1" Foreground="#AAAABC"/>
						<ItemsControl ItemsSource="{Binding ScheduledContracts}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Spacing="8"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="dto:ScheduledNenContractDto">
									<Border Background="#F8F8FB" CornerRadius="8" Padding="12,10">
										<Grid ColumnDefinitions="*,Auto,Auto">
											<StackPanel Grid.Column="0" Spacing="4">
												<TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A2E"/>
												<StackPanel Orientation="Horizontal" Spacing="4">
													<TextBlock Text="{Binding StartDate, StringFormat='{}{0:MMM d}'}" FontSize="11" Foreground="#888899"/>
													<TextBlock Text="–" FontSize="11" Foreground="#888899"/>
													<TextBlock Text="{Binding EndDate, StringFormat='{}{0:MMM d, yyyy}'}" FontSize="11" Foreground="#888899"/>
												</StackPanel>
												<TextBlock Text="{Binding StrictnessRule, Converter={x:Static conv:StrictnessRuleToLabelConverter.Instance}}"
                                                           FontSize="11" Foreground="#AAAABC"/>
											</StackPanel>
											<Button Grid.Column="1" Classes="bannerCancelBtn" Content="Edit"
                                                    Foreground="#1A1A2E"
                                                    Command="{Binding $parent[UserControl].((vm:PlannerPageViewModel)DataContext).RequestEditContractCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    IsEnabled="{Binding $parent[UserControl].((vm:PlannerPageViewModel)DataContext).CanOpenContractWizard}"
                                                    VerticalAlignment="Top"/>
											<Button Grid.Column="2" Classes="bannerCancelBtn" Content="Delete"
                                                    Command="{Binding $parent[UserControl].((vm:PlannerPageViewModel)DataContext).RequestDeleteContractCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    VerticalAlignment="Top"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<TextBlock Text="{Binding DeleteContractErrorMessage}"
                               IsVisible="{Binding DeleteContractErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12" Foreground="#C03A2B" TextWrapping="Wrap"/>

					<Button Classes="primary" Content="Make Nen Contract"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding OpenContractWizardCommand}"
                            IsEnabled="{Binding CanOpenContractWizard}"/>
				</StackPanel>
			</Border>
		</Popup>
	</Grid>
</UserControl>
