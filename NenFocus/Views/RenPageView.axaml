<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NenFocus.ViewModels.Ritual"
             xmlns:conv="using:NenFocus.Converters"
             x:DataType="vm:RenPageViewModel"
             x:Class="NenFocus.Views.RenPageView"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Button.profile-card">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E4E4EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.profile-card.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#FDF6E8"/>
            <Setter Property="BorderBrush" Value="#B8922A"/>
        </Style>
        <Style Selector="Button.profile-card /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#DDDDE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.chip /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.remove-tag">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#AAAABC"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Center" Width="600" Margin="0,0,0,40">
            <StackPanel Spacing="0">

                <!-- Kanji + Header -->
                <TextBlock Text="錬"
                           FontSize="72"
                           FontWeight="Thin"
                           Foreground="#DDDDE8"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                <TextBlock Text="Ren"
                           FontSize="32"
                           FontWeight="Light"
                           Foreground="#1A1A2E"
                           HorizontalAlignment="Center"
                           LetterSpacing="6"/>
                <TextBlock Text="Intensify your will."
                           FontSize="13"
                           FontStyle="Italic"
                           Foreground="#AAAABC"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,40"/>

                <!-- Loading -->
                <TextBlock IsVisible="{Binding IsLoading}"
                           Text="Loading profiles…"
                           FontSize="13"
                           Foreground="#AAAABC"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- Profile list -->
                <StackPanel IsVisible="{Binding !IsLoading}" Spacing="10" Margin="0,0,0,28">

                    <TextBlock Text="BLOCK PROFILE"
                               FontSize="9"
                               FontWeight="Medium"
                               Foreground="#AAAABC"
                               LetterSpacing="3"
                               Margin="0,0,0,6"/>

                    <!-- No profiles empty state -->
                    <TextBlock IsVisible="{Binding Profiles.Count, Converter={x:Static conv:CountToVisibilityConverter.IsZero}}"
                               Text="No profiles saved. Add apps or websites below for this session."
                               FontSize="13"
                               Foreground="#BBBBCC"
                               FontStyle="Italic"
                               TextWrapping="Wrap"/>

                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:RenProfileCardViewModel">
                                <Button Classes="profile-card"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding $parent[UserControl].((vm:RenPageViewModel)DataContext).SelectProfileCommand}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock Text="{Binding Profile.Name}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="#1A1A2E"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="#F0F0F8"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding Profile.WebsitePolicy}"
                                                               FontSize="10"
                                                               Foreground="#888899"/>
                                                </Border>
                                                <TextBlock FontSize="11" Foreground="#AAAABC"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{Binding Profile.AppCount}"/>
                                                    <Run Text=" apps · "/>
                                                    <Run Text="{Binding Profile.SiteCount}"/>
                                                    <Run Text=" sites"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Selected checkmark -->
                                        <TextBlock Grid.Column="1"
                                                   IsVisible="{Binding IsSelected}"
                                                   Text="✓"
                                                   FontSize="16"
                                                   Foreground="#B8922A"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Allowlist hint -->
                <Border IsVisible="{Binding AllowlistHintVisible}"
                        Background="#FDF6E8"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,40">
                    <TextBlock Text="Only listed websites will be accessible. All others will be blocked."
                               FontSize="12"
                               Foreground="#B8922A"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Continue -->
                <Button HorizontalAlignment="Center"
                        Command="{Binding ContinueCommand}"
                        Background="Transparent"
                        BorderBrush="#B8922A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="40,12"
                        Cursor="Hand">
                    <TextBlock Text="Continue"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="#B8922A"
                               LetterSpacing="2"/>
                </Button>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>


