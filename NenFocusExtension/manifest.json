{
  "manifest_version": 3,
  "name": "NenFocus Enforcer",
  "version": "1.0",
  "description": "Seamlessly blocks sites and reports attempts to NenFocus.",
  "permissions": [ "webNavigation", "tabs", "scripting" ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:5005/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [ "http://*/*", "https://*/*" ],
      "js": [ "poll.js" ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [ "blocked.html" ],
      "matches": [ "<all_urls>" ]
    }
  ]
}